# Optional backend database override (otherwise data/dsih.db).
# Set this in your shell; .env is not automatically loaded.
# DSIH_DATABASE_URL=sqlite:///C:/path/to/dsih.db

# Optional public or self-hosted NewsNow endpoint. Set in your shell.
NEWSNOW_API_URL=https://newsnow.busiyi.world/api/s

# Optional real LLM; set in shell. Base URL includes /v1 where required.
DSIH_LLM_BASE_URL=
DSIH_LLM_API_KEY=
DSIH_LLM_MODEL=
DSIH_LLM_TIMEOUT=

# Optional separate Qwen vision endpoint. Key value stays in the named environment variable.
DSIH_VISION_BASE_URL=
DSIH_VISION_MODEL=
DSIH_VISION_API_KEY_ENV=DSIH_VISION_API_KEY
DSIH_VISION_TIMEOUT=90

# Separate Google key with YouTube Data API v3 enabled; never put it in frontend code.
DSIH_YOUTUBE_API_KEY=
